---
import {
  REPOSITORY_NOTIFACTION_TYPES,
  type RepositoryRule,
} from "@pssbletrngle/workflows-types/metadata";
import Select from "./Select.astro";

export type Props = { value?: RepositoryRule; path: string };

const { value, path } = Astro.props;
---

<section class="rule-input">
  <input
    type="text"
    placeholder="Repository Name"
    name={`${path}[repo]`}
    value={value?.repo}
  />
  <input
    type="text"
    placeholder="Repository Owner"
    name={`${path}[owner]`}
    value={value?.owner}
  />
  <input
    type="text"
    placeholder="Branch"
    name={`${path}[branch]`}
    value={value?.branch}
  />
  <Select name={`${path}[type]`} options={REPOSITORY_NOTIFACTION_TYPES} selected={value?.type}>
    Type
  </Select>

  <button hx-on:click="this.closest('.rule-input').remove()">🗑️</button>
</section>

<style scoped>
  .rule-input {
    display: grid;
    grid-template-columns: repeat(5, 1fr) 100px;
    align-items: center;
    gap: 1em;
  }
</style>
